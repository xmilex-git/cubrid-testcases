               class: tb node[?]
               sargs: table(?) -> tb node[?] AND term[?]
               cost:  ? card ?
    sargs: term[?]
    cost:  ? card ?
Query stmt:
select v.ID, v.[Name] from tbl v, tbl tb where (v.ID< ?:? ) and v.MgrID=tb.ID
